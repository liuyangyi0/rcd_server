# Copy to ~/.config/RcdManager/agents/<instance-id>.env and edit before use.
# All paths below are placeholders; use real absolute paths, not ~, $HOME or %h.
# Keep a distinct executable/config directory and agent data directory per lower.
RCD_LOWER_EXECUTABLE=/absolute/path/to/lower-instance/rcd_server
RCD_LOWER_WORK_DIR=/absolute/path/to/lower-instance
RCD_AGENT_DATA_DIR=/absolute/path/to/agent-state/example-lower

# The agent has its own HTTP listener; this is not the manager Web listener.
RCD_AGENT_HTTP_LISTEN=0.0.0.0:8090
# TCP readiness only. This does not configure the lower's OPC listener.
RCD_LOWER_READY_ADDRESS=127.0.0.1:4841
# Inherited by the Rust child. Match READY_ADDRESS and the manager's OPC source.
RCD_OPCUA_PORT=4841

# First-run safety: start the agent, confirm the old lower is stopped, then start
# this owned lower explicitly. Later runs restore the saved desired state.
RCD_AGENT_AUTO_START=false
RCD_AGENT_RESTART_POLICY=never
RCD_AGENT_STOP_TIMEOUT=15s
RCD_AGENT_START_TIMEOUT=60s

# Optional: preserve an existing explicit Rust logging configuration if needed.
# RCD_CONFIG controls logging only, not the business config/ directory.
# RCD_CONFIG=/absolute/path/to/existing/logging-config.toml
