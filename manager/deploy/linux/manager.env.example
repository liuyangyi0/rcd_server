# Copy to ~/.config/RcdManager/manager.env and replace every placeholder with
# an absolute path or an explicit listener value. This file is not a shell script.
RCD_MANAGER_DATA_DIR=/absolute/path/to/manager/data
RCD_MANAGER_OPC_LISTEN=0.0.0.0:4840
RCD_MANAGER_OPC_ADVERTISE_HOST=192.168.10.46
RCD_MANAGER_HTTP_LISTEN=0.0.0.0:8087
RCD_MANAGER_LOWER_PUBLISHING_INTERVAL=50ms
RCD_MANAGER_LOWER_SAMPLING_INTERVAL=50ms
